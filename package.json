{
  "name": "llmfy-video",
  "version": "1.0.0",
  "scripts": {
    "start": "remotion studio",
    "build": "remotion render src/index.tsx LLMFYAd out/llmfy-ad.mp4",
    "render": "remotion render src/index.tsx LLMFYAd out/llmfy-ad.mp4 --codec h264",
    "sfx": "node scripts/make-sfx.mjs",
    "frames": "node scripts/scene-frames.mjs",
    "qa": "node scripts/qa-stills.mjs",
    "levels": "node scripts/audio-levels.mjs",
    "render:explainer": "remotion render src/index.tsx LLMFYExplainer out/llmfy-explainer.mp4 --codec h264 --crf 16 --jpeg-quality 95 --x264-preset slow"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.407",
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "4.0.407",
    "@remotion/layout-utils": "4.0.407",
    "@remotion/media-utils": "4.0.407",
    "@remotion/motion-blur": "4.0.407",
    "@remotion/noise": "4.0.407",
    "@remotion/paths": "4.0.407",
    "@remotion/shapes": "4.0.407",
    "@remotion/transitions": "4.0.407",
    "lucide-react": "^1.51.0",
    "playwright": "^1.57.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "typescript": "^5.0.0"
  }
}
